#!/usr/bin/env bash
# Written by Draco (tytydraco @ GitHub)

# The name of the current branch for logging purposes
BRANCH="balance"

# Maximum unsigned integer size in C
UINT_MAX="4294967295"

# Duration in nanoseconds of one scheduling period
SCHED_PERIOD="$((1 * 1000 * 1000))"

# How many tasks should we have at a maximum in one scheduling period
SCHED_TASKS="32"

echo "toto"

write() {
	# Bail out if file does not exist
	[[ ! -f "$1" ]] && return 1

	# Make file writable in case it is not already
	chmod +w "$1" 2> /dev/null

	# Write the new value and bail if there's an error
	if ! echo "$2" > "$1" 2> /dev/null
	then
		echo "Failed: $1 → $2"
		return 1
	fi

	# Log the success
	echo "$1 → $2"
}

# Check for root permissions and bail if not granted
if [[ "$(id -u)" -ne 0 ]]
then
	echo "No root permissions. Exiting."
	exit 1
fi

# Detect if we are running on Android
grep -q android /proc/cmdline && ANDROID=true

# Log the date and time for records sake
echo "Time of execution: $(date)"
echo "Branch: $BRANCH"

# Sync to data in the rare case a device crashes
sync

# Limit max perf event processing time to this much CPU usage
write /proc/sys/kernel/perf_cpu_time_max_percent 0

# Group tasks for less stutter but less throughput
write /proc/sys/kernel/sched_autogroup_enabled 0

# Execute child process before parent after fork
write /proc/sys/kernel/sched_child_runs_first 1

# Preliminary requirement for the following values
write /proc/sys/kernel/sched_tunable_scaling 0

# Reduce the maximum scheduling period for lower latency
write /proc/sys/kernel/sched_latency_ns "$SCHED_PERIOD"

# Schedule this ratio of tasks in the guarenteed sched period
write /proc/sys/kernel/sched_min_granularity_ns "$((SCHED_PERIOD / SCHED_TASKS))"

# Require preeptive tasks to surpass half of a sched period in vmruntime
write /proc/sys/kernel/sched_wakeup_granularity_ns "$((SCHED_PERIOD / 2))"

# Reduce the frequency of task migrations
write /proc/sys/kernel/sched_migration_cost_ns 50000

# Always allow sched boosting on top-app tasks
[[ "$ANDROID" == true ]] && write /proc/sys/kernel/sched_min_task_util_for_colocation 0

# Improve real time latencies by reducing the scheduler migration time
write /proc/sys/kernel/sched_nr_migrate 64

# Disable scheduler statistics to reduce overhead
write /proc/sys/kernel/sched_schedstats 0

# Disable unnecessary printk logging
write /proc/sys/kernel/printk_devkmsg off

# Start non-blocking writeback later
write /proc/sys/vm/dirty_background_ratio 10

# Start blocking writeback later
write /proc/sys/vm/dirty_ratio 30

# Require dirty memory to stay in memory for longer
write /proc/sys/vm/dirty_expire_centisecs 3000

# Run the dirty memory flusher threads less often
write /proc/sys/vm/dirty_writeback_centisecs 3000

# Disable read-ahead for swap devices
write /proc/sys/vm/page-cluster 0

# Update /proc/stat less often to reduce jitter
write /proc/sys/vm/stat_interval 10

# Swap to the swap device at a fair rate
write /proc/sys/vm/swappiness 100

# Fairly prioritize page cache and file structures
write /proc/sys/vm/vfs_cache_pressure 400

# Enable Explicit Congestion Control
write /proc/sys/net/ipv4/tcp_ecn 1

# Enable fast socket open for receiver and sender
write /proc/sys/net/ipv4/tcp_fastopen 3

# Disable SYN cookies
write /proc/sys/net/ipv4/tcp_syncookies 0

if [[ -f "/sys/kernel/debug/sched_features" ]]
then
	# Consider scheduling tasks that are eager to run
	write /sys/kernel/debug/sched_features NEXT_BUDDY

	# Schedule tasks on their origin CPU if possible
	write /sys/kernel/debug/sched_features TTWU_QUEUE
fi

[[ "$ANDROID" == true ]] && if [[ -d "/dev/stune/" ]]
then
	# We are not concerned with prioritizing latency
	write /dev/stune/top-app/schedtune.prefer_idle 0

	# Mark top-app as boosted, find high-performing CPUs
	write /dev/stune/top-app/schedtune.boost 100
fi

# Loop over each CPU in the system
for cpu in /sys/devices/system/cpu/cpu*/cpufreq
do
	# Fetch the available governors from the CPU
	avail_govs="$(cat "$cpu/scaling_available_governors")"

	# Attempt to set the governor in this order
	for governor in schedutil interactive
	do
		# Once a matching governor is found, set it and break for this CPU
		if [[ "$avail_govs" == *"$governor"* ]]
		then
			write "$cpu/scaling_governor" "$governor"
			break
		fi
	done
done

# Apply governor specific tunables for schedutil
find /sys/devices/system/cpu/ -name schedutil -type d | while IFS= read -r governor
do
	# Consider changing frequencies once per scheduling period
	write "$governor/up_rate_limit_us" "$((SCHED_PERIOD / 1000))"
	write "$governor/down_rate_limit_us" "$((2 * SCHED_PERIOD / 1000))"
	write "$governor/rate_limit_us" "$((SCHED_PERIOD / 1000))"

	# Jump to hispeed frequency at this load percentage
	write "$governor/hispeed_load" 1
	write "$governor/hispeed_freq" "$UINT_MAX"
done

# Apply governor specific tunables for interactive
find /sys/devices/system/cpu/ -name interactive -type d | while IFS= read -r governor
do
	# Consider changing frequencies once per scheduling period
	write "$governor/timer_rate" "$((SCHED_PERIOD / 1000))"
	write "$governor/min_sample_time" "$((SCHED_PERIOD / 1000))"

	# Jump to hispeed frequency at this load percentage
	write "$governor/go_hispeed_load" 1
	write "$governor/hispeed_freq" "$UINT_MAX"
done

for queue in /sys/block/*/queue
do
	# Choose the first governor available
	avail_scheds="$(cat "$queue/scheduler")"
	for sched in cfq noop kyber bfq mq-deadline none
	do
		if [[ "$avail_scheds" == *"$sched"* ]]
		then
			write "$queue/scheduler" "$sched"
			break
		fi
	done

	# Do not use I/O as a source of randomness
	write "$queue/add_random" 0

	# Disable I/O statistics accounting
	write "$queue/iostats" 0

	# Reduce heuristic read-ahead in exchange for I/O latency
	write "$queue/read_ahead_kb" 512

	# Reduce the maximum number of I/O requests in exchange for latency
	write "$queue/nr_requests" 256
done


###############################################################################
# === GPU Adreno 506 : pwrlevels (msm8953) + GPUBW sans min/max ===
###############################################################################
if [[ -d /sys/class/kgsl/kgsl-3d0 ]]; then
  echo "=== [GPU] Adreno 506 : pwrlevel ==="

  # Gouverneur devfreq stable
  if [[ -f /sys/class/kgsl/kgsl-3d0/devfreq/available_governors ]]; then
    if grep -q "cpufreq" /sys/class/kgsl/kgsl-3d0/devfreq/available_governors; then
      write /sys/class/kgsl/kgsl-3d0/devfreq/governor cpufreq
      echo "[GPU] governor=cpufreq"
    elif grep -q "msm-adreno-tz" /sys/class/kgsl/kgsl-3d0/devfreq/available_governors; then
      write /sys/class/kgsl/kgsl-3d0/devfreq/governor msm-adreno-tz
      echo "[GPU] governor=msm-adreno-tz"
    fi
  fi

  # Priorité : pwrlevels (0 = perf max). Garde 1 pour petite marge thermique.
  if [[ -f /sys/class/kgsl/kgsl-3d0/min_pwrlevel && -f /sys/class/kgsl/kgsl-3d0/max_pwrlevel ]]; then
    write /sys/class/kgsl/kgsl-3d0/min_pwrlevel 0
    write /sys/class/kgsl/kgsl-3d0/max_pwrlevel 0
    echo "[GPU] pwrlevel min=max=0"
  else
    # Fallback devfreq si pas de pwrlevels utilisables
    if [[ -f /sys/class/kgsl/kgsl-3d0/devfreq/available_frequencies ]]; then
      gpu_max=$(tr ' ' '\n' < /sys/class/kgsl/kgsl-3d0/devfreq/available_frequencies | sort -n | tail -1)
      if [[ -n "$gpu_max" && "$gpu_max" -gt 0 ]]; then
        write /sys/class/kgsl/kgsl-3d0/devfreq/min_freq $((gpu_max * 10 / 10))
        write /sys/class/kgsl/kgsl-3d0/devfreq/max_freq $gpu_max
        echo "[GPU] devfreq freq: min=$((gpu_max*10/10)) max=$gpu_max"
      fi
    fi
  fi

  # Activation rapide (latence)
  [[ -f /sys/class/kgsl/kgsl-3d0/force_clk_on ]] && write /sys/class/kgsl/kgsl-3d0/force_clk_on 1
  [[ -f /sys/class/kgsl/kgsl-3d0/force_bus_on ]] && write /sys/class/kgsl/kgsl-3d0/force_bus_on 1
  [[ -f /sys/class/kgsl/kgsl-3d0/force_rail_on ]] && write /sys/class/kgsl/kgsl-3d0/force_rail_on 1
fi

###############################################################################
# === GPUBW : gouverneur seulement (évite OPP -19) ===
###############################################################################
if [[ -d /sys/class/devfreq/soc:qcom,gpubw ]]; then
  echo "=== [GPUBW] Bus mémoire ==="
  if [[ -f /sys/class/devfreq/soc:qcom,gpubw/available_governors ]] && \
     grep -q "bw_hwmon" /sys/class/devfreq/soc:qcom,gpubw/available_governors; then
    write /sys/class/devfreq/soc:qcom,gpubw/governor bw_hwmon || true
    # petits réglages si exposés
    [[ -f /sys/class/devfreq/soc:qcom,gpubw/io_percent ]] && write /sys/class/devfreq/soc:qcom,gpubw/io_percent 100
    [[ -f /sys/class/devfreq/soc:qcom,gpubw/sample_ms  ]] && write /sys/class/devfreq/soc:qcom,gpubw/sample_ms 2
    [[ -f /sys/class/devfreq/soc:qcom,gpubw/up_scale   ]] && write /sys/class/devfreq/soc:qcom,gpubw/up_scale 500
    echo "[GPUBW] governor=bw_hwmon (tuned)"
  else
    write /sys/class/devfreq/soc:qcom,gpubw/governor cpufreq || true
    echo "[GPUBW] governor=cpufreq"
  fi
  # NE PAS écrire min/max ici (pour éviter "OPP not found (-19)")
fi


###############################################################################
# === VENUS / DSP : SSR RELATED + AGGRESSIVE freq tuning (L1-safe-ish) ===
###############################################################################
echo "=== [VPU/DSP] Stabilisation + tuning AGRESSIF (Widevine L1 toléré) ==="

# -- 1) Forcer restart_level=RELATED sur venus/adsp
echo "=== [SSR] Mise à jour restart_level (msm_subsys) ==="
for d in /sys/bus/msm_subsys/devices/*; do
  [ -d "$d" ] || continue
  nfile="$d/name"; rfile="$d/restart_level"
  [ -f "$nfile" ] && [ -f "$rfile" ] || continue
  name=$(cat "$nfile" 2>/dev/null)
  if echo "$name" | grep -qiE 'venus|adsp'; then
    cur=$(cat "$rfile" 2>/dev/null)
    echo "[SSR] $name: restart_level current=$cur"
    echo RELATED > "$rfile" 2>/dev/null && echo "[SSR] $name: restart_level -> RELATED"
  fi
done

# -- 2) Fonction tuning agressif (palier max-1 si possible)
tune_devfreq_aggressive() {
  dev="$1"
  [ -d "$dev" ] || return 0
  [ -f "$dev/governor" ] && write "$dev/governor" performance

  if [ -f "$dev/available_frequencies" ]; then
    # Extraction sans tableau (compat Android shell)
    freqs=$(tr ' ' '\n' < "$dev/available_frequencies" | awk '$1>0' | sort -n)
    count=$(echo "$freqs" | wc -l)
    if [ "$count" -lt 2 ]; then
      echo "[VPU] $dev: pas assez de paliers, skip"
      return 0
    fi

    # Choisir le palier max-1
    target=$(echo "$freqs" | tail -n 2 | head -n 1)
    [ -f "$dev/min_freq" ] && write "$dev/min_freq" "$target"
    [ -f "$dev/max_freq" ] && write "$dev/max_freq" "$target"
    echo "[VPU] AGGR $dev -> min=max=$target"

  elif [ -f "$dev/max_freq" ] && [ -f "$dev/min_freq" ]; then
    maxv=$(cat "$dev/max_freq" | grep -Eo '[0-9]+')
    if [ ! -z "$maxv" ]; then
      expr "$maxv" + 1 >/dev/null 2>&1 || { echo "[VPU] $dev: max_freq invalide ($maxv)"; return 0; }
      write "$dev/min_freq" "$maxv"
      write "$dev/max_freq" "$maxv"
      echo "[VPU] AGGR $dev -> min=max=$maxv"
    else
      echo "[VPU] $dev: max_freq vide, skip"
    fi
  else
    echo "[VPU] $dev: aucun nœud de fréquence utilisable, skip"
  fi
}

# -- 3) Appliquer tuning agressif sur tous les modules vidéo/DSP
echo "=== [VPU/DSP] Tuning freq (AGGRESSIVE) ==="
for dev in /sys/class/devfreq/*venus* /sys/class/devfreq/*vidc* /sys/class/devfreq/*video* /sys/class/devfreq/*adsp*; do
  [ -d "$dev" ] || continue
  tune_devfreq_aggressive "$dev"
done

# -- 4) Empêcher la mise en veille complète du bloc VIDC si possible
for f in /sys/kernel/debug/msm_vidc/*/disable_pc /sys/kernel/debug/msm_vidc/disable_pc; do
  [ -f "$f" ] && write "$f" 1 && echo "[VPU] disable_pc activé sur $f"
done

# -- 5) Diagnostic court pour vérifier état
echo "=== [VPU DEBUG] États venus/adsp récents ==="
dmesg | grep -iE "venus|vidc|sysmon_send_shutdown|Brought out of reset|zap|mdt|b0[234]" | tail -n 80




# Rendre le SSR plus verbeux (debug)
echo 1 > /sys/module/subsystem_restart/parameters/enable_debug 2>/dev/null

###############################################################################
# === Option YouTube/ads : éviter VP9/HEVC HW (réduit triggers de reset venus) ===
###############################################################################
# Si HEVC HW indispensable pour certaines apps DRM, commente ces deux lignes :
setprop debug.media.omx.disable.vp9 true
setprop debug.media.omx.disable.hevc true










###############################################################################
# DEBUG court
echo "=== [DEBUG] Derniers VENUS/KGSL ==="
dmesg | grep -iE "venus|vidc|kgsl|adreno|detach context|sysmon_send_shutdown|Brought out of reset|OPP not found" | tail -n 120
echo "=== [DEBUG] Fin bloc perf/stab ==="


###############################################################################
# === AUDIO / ADSP STABILISATION (Dolby actif, L1 préservé) ===
# But : éviter les resets ADSP lors des changements de codec/volume élevés
#       -> on désactive l'audio "compress offload" (DSP) et MMAP
#       -> on garde la vidéo Widevine L1 (pipeline vidéo inchangé)
###############################################################################
echo "=== [AUDIO] Stabilisation ADSP / Dolby ==="

# 1) Désactiver l'audio offload (fait décoder l'audio côté CPU en PCM)
setprop vendor.audio.offload.disable 1
setprop audio.offload.disable 1
setprop vendor.audio.offload.passthrough 0
setprop vendor.audio.offload.multiple.enabled 0
setprop vendor.audio.offload.track.enable 0
setprop vendor.audio.offload.gapless.enabled 0

# Désactiver offload pour codecs sensibles (AC3/EAC3/AAC change souvent sur pubs)
setprop vendor.audio.offload.codec.ac3 false
setprop vendor.audio.offload.codec.eac3 false
setprop vendor.audio.offload.codec.aac false

# 2) Éviter AAudio/MMAP (souvent instable sur anciens SoC)
setprop aaudio.mmap_policy 2                 # 2 = NEVER
setprop aaudio.mmap_exclusive_policy 2

# 3) Forcer le chemin PCM "classique" (moins d'effets, plus stable)
setprop persist.vendor.audio.fluence.speaker false
setprop persist.vendor.audio.fluence.voicecall false
setprop persist.vendor.audio.fluence.voicerec false

# 4) Garder Dolby chargé mais réduire les risques d’overdrive (option doux)
#    -> si ça continue de rebooter au volume max, décommente la ligne bypass.
setprop persist.vendor.dolby.dap.bypass 1   # Bypass DAP, garde le service, baisse la charge DSP
setprop vendor.audio_hal.period_size 192
setprop vendor.audio.adm.buffering.ms 12

# 5) Donner la priorité CPU aux services audio/codecs (latence ↓)
for p in audioserver media.codec media.swcodec mediaserver; do
  for pid in $(pidof "$p" 2>/dev/null); do
    echo "$pid" > /dev/stune/top-app/tasks 2>/dev/null
  done
done

# 6) Snapshot debug utile après réglages
echo "=== [AUDIO DEBUG] Props clés ==="
getprop vendor.audio.offload.disable
getprop audio.offload.disable
getprop vendor.audio.offload.codec.ac3
getprop vendor.audio.offload.codec.eac3
getprop aaudio.mmap_policy
getprop persist.vendor.dolby.dap.bypass
getprop vendor.audio_hal.period_size
getprop vendor.audio.adm.buffering.ms
echo "=== [AUDIO DEBUG] Derniers logs ADSP/audio ==="
dmesg | grep -iE "adsp|audio|q6|apr|fatal|reset" | tail -n 80


# Always return success, even if the last write fails
exit 0
