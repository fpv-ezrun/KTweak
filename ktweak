#!/usr/bin/env bash
# ==========================================================================================
#  PROFILE: OVERDRIVE / MAX-PERF (R&D STRESS ONLY)
#  - Pousse CPU/GPU/RAM/IO à fond : gouverneurs "performance", fréquences au max,
#    latences minimisées, caches agressifs, BBR, etc.
#  - **ATTENTION** : usage labo uniquement. Peut chauffer, vider la batterie,
#    réduire la durée de vie, provoquer des throttles et de l'instabilité.
#    Ne désactive PAS les protections thermiques (volontaire).
# ==========================================================================================

set -Eeuo pipefail

BRANCH="overdrive"
echo "toto"

# =========================
# === Utilitaires I/O ====
# =========================
log()   { echo "[*] $*"; }
warn()  { echo "[!] $*" >&2; }
fail()  { echo "[x] $*" >&2; }

write() {
  local path="$1" val="${2:-}"
  [[ -z "${path}" || ! -e "${path}" ]] && return 1
  chmod u+w "${path}" 2>/dev/null || true
  if ! printf '%s' "${val}" > "${path}" 2>/dev/null; then
    fail "Failed: ${path} → ${val}"
    return 1
  fi
  echo "${path} → ${val}"
}

append_if_supported() {
  local path="$1" token="$2"
  [[ -e "${path}" ]] || return 1
  if grep -qw "${token}" "${path}"; then
    printf '%s' "${token}" > "${path}" 2>/dev/null && echo "${path} += ${token}"
  fi
}

# ===============================
# === Preconditions / Contexte ==
# ===============================
if [[ "$(id -u)" -ne 0 ]]; then
  fail "Exécuter en root."
  exit 1
fi

ANDROID=false
grep -qi android /proc/cmdline && ANDROID=true

echo "Heure: $(date)"
echo "Profil: ${BRANCH}"
sync

# ====================================
# === Constantes / paramètres base ===
# ====================================
# Période d'ordonnancement (ns) – courte pour réactivité
SCHED_PERIOD_NS=$((1 * 1000 * 1000))   # 1 ms
SCHED_TASKS=32

# ==========================
# === Kernel / Scheduler ===
# ==========================
# Perf events non limités (0 = illimité)
write /proc/sys/kernel/perf_cpu_time_max_percent 0 || true

# Pas d'autogroup → moins d'overhead
write /proc/sys/kernel/sched_autogroup_enabled 0 || true

# Les enfants s'exécutent avant le parent après fork
write /proc/sys/kernel/sched_child_runs_first 1 || true

# Désactiver scaling heuristique
write /proc/sys/kernel/sched_tunable_scaling 0 || true

# Latences faibles + time slice court
write /proc/sys/kernel/sched_latency_ns "${SCHED_PERIOD_NS}" || true
write /proc/sys/kernel/sched_min_granularity_ns "$((SCHED_PERIOD_NS / SCHED_TASKS))" || true
# Favoriser le préemptif agressif
write /proc/sys/kernel/sched_wakeup_granularity_ns 0 || true

# Réduire migrations (garder les caches chauds)
write /proc/sys/kernel/sched_migration_cost_ns 500000 || true  # 0.5 ms
write /proc/sys/kernel/sched_nr_migrate 128 || true

# Stats scheduler off → moins d'overhead
write /proc/sys/kernel/sched_schedstats 0 || true

# Boost global (EAS) si dispo
[[ -e /proc/sys/kernel/sched_boost ]] && write /proc/sys/kernel/sched_boost 1 || true

# Réduire les logs noyau au strict minimum
[[ -e /proc/sys/kernel/printk ]] && write /proc/sys/kernel/printk "0 0 0 0" || true
write /proc/sys/kernel/printk_devkmsg off || true

# Features de scheduling debug (si présents)
if [[ -f /sys/kernel/debug/sched_features ]]; then
  # Favoriser la réutilisation CPU et les réveils efficaces
  append_if_supported /sys/kernel/debug/sched_features NO_ENERGY_AWARE
  append_if_supported /sys/kernel/debug/sched_features NEXT_BUDDY
  append_if_supported /sys/kernel/debug/sched_features TTWU_QUEUE
fi

# =================
# === Mémoire VM ==
# =================
# Dirty writeback plus tard → +débit (attention aux pertes en cas de crash)
write /proc/sys/vm/dirty_background_ratio 10 || true
write /proc/sys/vm/dirty_ratio 40 || true
write /proc/sys/vm/dirty_expire_centisecs 3000 || true
write /proc/sys/vm/dirty_writeback_centisecs 3000 || true

# Statistiques VM moins fréquentes
write /proc/sys/vm/stat_interval 10 || true

# Swappiness minimal → éviter le swap (performances)
write /proc/sys/vm/swappiness 1 || true

# Garder agressivement caches VFS
write /proc/sys/vm/vfs_cache_pressure 50 || true

# Read-ahead swap désactivé
write /proc/sys/vm/page-cluster 0 || true

# THP agressif si dispo
[[ -e /sys/kernel/mm/transparent_hugepage/enabled ]] && write /sys/kernel/mm/transparent_hugepage/enabled always || true
[[ -e /sys/kernel/mm/transparent_hugepage/defrag  ]] && write /sys/kernel/mm/transparent_hugepage/defrag  always || true

# Augmenter les mappings si lourds workloads
[[ -e /proc/sys/vm/max_map_count ]] && write /proc/sys/vm/max_map_count 1048576 || true

# Désactiver KSM si présent (évite l’overhead CPU)
if [[ -e /sys/kernel/mm/ksm/run ]]; then
  write /sys/kernel/mm/ksm/run 0 || true
fi

# =====================
# === Réseau (TCP) ====
# =====================
# BBR + FQ pour latence faible et débit élevé
[[ -e /proc/sys/net/core/default_qdisc ]] && write /proc/sys/net/core/default_qdisc fq || true
if [[ -e /proc/sys/net/ipv4/tcp_congestion_control ]]; then
  if grep -qw bbr /proc/sys/net/ipv4/tcp_available_congestion_control 2>/dev/null; then
    write /proc/sys/net/ipv4/tcp_congestion_control bbr
  fi
fi

# ECN + Fast Open
write /proc/sys/net/ipv4/tcp_ecn 1 || true
write /proc/sys/net/ipv4/tcp_fastopen 3 || true

# Backlog large
[[ -e /proc/sys/net/core/somaxconn ]] && write /proc/sys/net/core/somaxconn 4096 || true

# ==================
# === CPU / CStates
# ==================
# Désactiver watchdog NMI (overhead)
[[ -e /proc/sys/kernel/nmi_watchdog ]] && write /proc/sys/kernel/nmi_watchdog 0 || true

# Désactiver les états d’idle profonds (latence ↓, perf ↑, conso ↑)
for s in /sys/devices/system/cpu/cpu*/cpuidle/state*/disable; do
  [[ -e "$s" ]] && write "$s" 1 || true
done

# Turbo/Boost
[[ -e /sys/devices/system/cpu/intel_pstate/no_turbo ]] && write /sys/devices/system/cpu/intel_pstate/no_turbo 0 || true
[[ -e /sys/devices/system/cpu/cpufreq/boost          ]] && write /sys/devices/system/cpu/cpufreq/boost 1 || true
[[ -e /sys/devices/system/cpu/cpufreq/amd_pstate/status ]] && write /sys/devices/system/cpu/cpufreq/amd_pstate/status active || true

# Gouverneur CPU : performance + verrouillage min/max = max
for pol in /sys/devices/system/cpu/cpufreq/policy*; do
  [[ -d "$pol" ]] || continue
  maxf=""
  if [[ -e "$pol/scaling_max_freq" ]]; then
    maxf="$(cat "$pol/cpuinfo_max_freq" 2>/dev/null || true)"
    [[ -n "${maxf}" ]] && write "$pol/scaling_max_freq" "${maxf}" || true
    [[ -n "${maxf}" ]] && write "$pol/scaling_min_freq" "${maxf}" || true
  fi

  # Choix du gouverneur
  if grep -qw performance "$pol/scaling_available_governors" 2>/dev/null; then
    write "$pol/scaling_governor" performance
  elif grep -qw schedutil "$pol/scaling_available_governors" 2>/dev/null; then
    write "$pol/scaling_governor" schedutil
  elif grep -qw interactive "$pol/scaling_available_governors" 2>/dev/null; then
    write "$pol/scaling_governor" interactive
  fi

  # Tuning gouverneurs si présents
  if [[ -d "$pol/schedutil" ]]; then
    # Changement de freq immédiat
    write "$pol/schedutil/up_rate_limit_us"   0 || true
    write "$pol/schedutil/down_rate_limit_us" 0 || true
    write "$pol/schedutil/rate_limit_us"      0 || true
  fi
  if [[ -d "$pol/interactive" ]]; then
    # hispeed au max
    [[ -n "${maxf}" ]] && write "$pol/interactive/hispeed_freq" "${maxf}" || true
    write "$pol/interactive/go_hispeed_load" 1 || true
    write "$pol/interactive/timer_rate" 20000 || true
    write "$pol/interactive/min_sample_time" 20000 || true
  fi
done

# Compat Android : cpusets / stune au taquet
if [[ "${ANDROID}" == true ]]; then
  # Tous les CPU alloués aux groupes actifs
  ONLINE="$(cat /sys/devices/system/cpu/online 2>/dev/null || echo 0)"
  for cg in /dev/cpuset/top-app /dev/cpuset/foreground /dev/cpuset/background /dev/cpuset/system-background; do
    [[ -d "$cg" && -w "$cg/cpus" ]] && write "$cg/cpus" "${ONLINE}" || true
  done

  # Boost schedtune
  if [[ -d /dev/stune ]]; then
    write /dev/stune/top-app/schedtune.boost 100 || true
    [[ -e /dev/stune/top-app/schedtune.prefer_idle ]] && write /dev/stune/top-app/schedtune.prefer_idle 0 || true
    [[ -e /dev/stune/top-app/schedtune.prefer_high_cap ]] && write /dev/stune/top-app/schedtune.prefer_high_cap 1 || true
  fi
fi

# =========================
# === GPU / DEVFREQ KGSL ==
# =========================
if [[ -d /sys/class/kgsl/kgsl-3d0 ]]; then
  log "[GPU] Tuning KGSL"

  # Gouverneur performance si possible
  if grep -qw performance /sys/class/kgsl/kgsl-3d0/devfreq/available_governors 2>/dev/null; then
    write /sys/class/kgsl/kgsl-3d0/devfreq/governor performance
  elif grep -qw msm-adreno-tz /sys/class/kgsl/kgsl-3d0/devfreq/available_governors 2>/dev/null; then
    write /sys/class/kgsl/kgsl-3d0/devfreq/governor msm-adreno-tz
  elif grep -qw cpufreq /sys/class/kgsl/kgsl-3d0/devfreq/available_governors 2>/dev/null; then
    write /sys/class/kgsl/kgsl-3d0/devfreq/governor cpufreq
  fi

  # Min/Max = Max
  if [[ -e /sys/class/kgsl/kgsl-3d0/devfreq/max_freq ]]; then
    MAX_GPU="$(cat /sys/class/kgsl/kgsl-3d0/devfreq/max_freq)"
    [[ -n "${MAX_GPU}" ]] && write /sys/class/kgsl/kgsl-3d0/devfreq/min_freq "${MAX_GPU}" || true
    [[ -n "${MAX_GPU}" ]] && write /sys/class/kgsl/kgsl-3d0/devfreq/max_freq "${MAX_GPU}" || true
  fi

  # Pwrlevels : 0 = perf max
  if [[ -e /sys/class/kgsl/kgsl-3d0/num_pwrlevels ]]; then
    write /sys/class/kgsl/kgsl-3d0/min_pwrlevel 0 || true
    write /sys/class/kgsl/kgsl-3d0/max_pwrlevel 0 || true
    [[ -e /sys/class/kgsl/kgsl-3d0/default_pwrlevel ]] && write /sys/class/kgsl/kgsl-3d0/default_pwrlevel 0 || true
  fi

  # Garder horloges/bus/rails actifs + idle timer nul
  write /sys/class/kgsl/kgsl-3d0/force_clk_on 1 || true
  write /sys/class/kgsl/kgsl-3d0/force_bus_on 1 || true
  write /sys/class/kgsl/kgsl-3d0/force_rail_on 1 || true
  [[ -e /sys/class/kgsl/kgsl-3d0/idle_timer ]] && write /sys/class/kgsl/kgsl-3d0/idle_timer 0 || true
fi

# GPUBW et autres devfreq : forcer performance + min=max
for df in /sys/class/devfreq/*; do
  [[ -d "$df" ]] || continue
  if [[ -e "$df/available_governors" && -w "$df/governor" ]]; then
    if grep -qw performance "$df/available_governors"; then
      write "$df/governor" performance
    elif grep -qw cpufreq "$df/available_governors"; then
      write "$df/governor" cpufreq
    fi
  fi
  if [[ -e "$df/max_freq" ]]; then
    MAXBW="$(cat "$df/max_freq" 2>/dev/null || true)"
    [[ -n "${MAXBW}" && -w "$df/min_freq" ]] && write "$df/min_freq" "${MAXBW}" || true
    [[ -n "${MAXBW}" ]] && write "$df/max_freq" "${MAXBW}" || true
  fi
done

# ===================
# === Stockage I/O ==
# ===================
for queue in /sys/block/*/queue; do
  [[ -d "$queue" ]] || continue

  # Choisir l’ordonnanceur : none > mq-deadline > kyber > bfq > noop
  if [[ -w "$queue/scheduler" ]]; then
    avail="$(cat "$queue/scheduler" 2>/dev/null || true)"
    for s in none mq-deadline kyber bfq noop; do
      if [[ "$avail" == *"$s"* ]]; then
        write "$queue/scheduler" "$s"
        break
      fi
    done
  fi

  # Pas d'entropie via I/O + pas d'iostats
  [[ -w "$queue/add_random" ]] && write "$queue/add_random" 0 || true
  [[ -w "$queue/iostats"    ]] && write "$queue/iostats" 0 || true
  [[ -w "$queue/rq_affinity" ]] && write "$queue/rq_affinity" 2 || true

  # Read-ahead : SSD/NVMe élevé, HDD modéré
  if [[ -e "$queue/rotational" ]] && [[ -e "$queue/read_ahead_kb" ]]; then
    if [[ "$(cat "$queue/rotational")" -eq 0 ]]; then
      write "$queue/read_ahead_kb" 2048
      [[ -w "$queue/nr_requests" ]] && write "$queue/nr_requests" 1024 || true
    else
      write "$queue/read_ahead_kb" 128
      [[ -w "$queue/nr_requests" ]] && write "$queue/nr_requests" 256  || true
    fi
  fi
done

# ===================================
# === Compatibilité de l'ancien code
# ===================================
# Conserver quelques valeurs issues du script original lorsqu'elles ne nuisent pas.
# (beaucoup sont déjà couvertes / renforcées ci-dessus)
UINT_MAX="4294967295"
# Ajustements "interactive"/"schedutil" supplémentaires si exposés ailleurs que policy*
find /sys/devices/system/cpu/ -name schedutil -type d 2>/dev/null | while IFS= read -r g; do
  write "$g/up_rate_limit_us" 0 || true
  write "$g/down_rate_limit_us" 0 || true
  write "$g/rate_limit_us" 0 || true
  # hispeed_* non standard -> ignoré si absent
  [[ -e "$g/hispeed_load" ]] && write "$g/hispeed_load" 1 || true
done
find /sys/devices/system/cpu/ -name interactive -type d 2>/dev/null | while IFS= read -r g; do
  write "$g/timer_rate" 20000 || true
  write "$g/min_sample_time" 20000 || true
  [[ -e "$g/hispeed_freq" ]] && write "$g/hispeed_freq" "$UINT_MAX" || true
  [[ -e "$g/go_hispeed_load" ]] && write "$g/go_hispeed_load" 1 || true
done

# =====================
# === Diagnostics ====
# =====================
echo "=== [DEBUG] Collecte de logs kernel / system ==="

echo "--- Derniers GPU / KGSL / Adreno faults ---"
dmesg | grep -iE "kgsl|adreno|gpu|kgsl-3d0|hang|fault|watchdog|panic" 2>/dev/null | tail -n 20 || true

echo "--- Derniers logs multimédia / audio / video ---"
dmesg | grep -iE "adsp|audio|dsp|video|vidc|venus|q6|fatal|reset" 2>/dev/null | tail -n 20 || true

if grep -q "Kernel panic" /proc/last_kmsg 2>/dev/null; then
  echo "--- Extrait du dernier kernel panic ---"
  grep -iE "panic|kgsl|adreno|adsp|fatal" /proc/last_kmsg 2>/dev/null | tail -n 20 || true
else
  echo "--- Aucun kernel panic enregistré ---"
fi

echo "=== [DEBUG] Températures actuelles ==="
for t in /sys/class/thermal/thermal_zone*/temp; do
  [[ -f "$t" ]] || continue
  name=$(basename "$(dirname "$t")")
  val=$(cat "$t" 2>/dev/null || echo 0)
  [[ -n "$val" ]] && echo "$name: $((val / 1000))°C"
done

echo "=== [DEBUG] Fin de la collecte ==="

# Toujours 0 (on est en mode best-effort, beaucoup de chemins peuvent ne pas exister)
exit 0
